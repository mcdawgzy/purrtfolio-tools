# Discord Webhook URL for posting market updates
# Get this from Discord Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional: Customize the cron schedule (default: 7 AM daily)
# CRON_SCHEDULE=0 7 * * *

# LLM credentials (auto-read from ~/.hermes/auth.json in production)
# If running outside Hermes, set these explicitly:
# NOUS_ACCESS_TOKEN=your_nous_access_token
# NOUS_API_BASE_URL=https://inference-api.nousresearch.com/v1
